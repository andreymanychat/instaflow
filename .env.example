# =============================================================================
# InstaFlow — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e cadastre as mesmas na Vercel
# (Project → Settings → Environment Variables).
# =============================================================================

# URL pública do app, SEM barra no final.
# Local: http://localhost:3000   |   Produção: https://seuprojeto.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Project Settings → API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# "anon" / "publishable" key (pública)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" / "secret" key — NUNCA exponha no frontend
SUPABASE_SERVICE_ROLE_KEY=

# --- Meta / Instagram (Casos de uso → Instagram → Personalizar) ---------------
# "ID do app do Instagram" e "Chave secreta do app do Instagram"
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# String aleatória de 48+ caracteres; a MESMA colada no campo "Verificar token" do webhook
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v23.0
# Opcional: "Chave secreta do aplicativo" em Configurações do app → Básico.
# Aceita como alternativa na validação da assinatura dos webhooks.
META_APP_SECRET=

# --- Segurança -----------------------------------------------------------------
# 32 bytes em hex (64 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ATENÇÃO: trocar esta chave invalida os tokens do Instagram já salvos.
TOKEN_ENCRYPTION_KEY=
# Segredo do agendador (pg_cron envia "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=

# --- OpenAI (opcional, habilita as respostas com IA) ----------------------------
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-5-mini

# --- Pagamentos: Asaas (cartão de crédito e Pix) ----------------------------------
# Sem a chave o checkout fica desativado e todos seguem no plano Free.
# Sandbox: https://sandbox.asaas.com → Integrações → Chave de API
ASAAS_API_KEY=
# sandbox | production
ASAAS_ENVIRONMENT=sandbox
# Token livre (ex.: 32 bytes hex) cadastrado no webhook do Asaas; chega no header asaas-access-token
ASAAS_WEBHOOK_TOKEN=
